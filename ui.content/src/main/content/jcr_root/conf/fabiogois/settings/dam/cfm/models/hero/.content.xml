<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/fabiogois(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/fabiogois/settings/dam/cfm/models/hero/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="Bloco de destaque com imagem e chamada."
        jcr:primaryType="cq:PageContent"
        jcr:title="Hero"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <metadata jcr:primaryType="nt:unstructured"/>
        <model
            cq:targetPath="/content/entities"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="20">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="20">
                        <title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Title"
                            listOrder="1"
                            maxlength="255"
                            metaType="text-single"
                            name="title"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string"
                            required="on">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </title>
                        <subtitle
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
                            cfm-element="Subtitle"
                            checked="true"
                            default-mime-type="text/plain"
                            listOrder="2"
                            metaType="text-multi"
                            name="subtitle"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            translatable="true"
                            valueType="string/multiline"/>
                        <image
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/contentreference"
                            fieldLabel="Image"
                            filter="hierarchy"
                            listOrder="3"
                            metaType="reference"
                            name="image"
                            nameSuffix="contentReference"
                            renderReadOnly="false"
                            rootPath="/content/dam/fabiogois"
                            showEmptyInReadOnly="true"
                            showThumbnail="true"
                            validation="cfm.validation.contenttype.image"
                            valueType="string/reference">
                            <granite:data jcr:primaryType="nt:unstructured" showThumbnail="true" thumbnail-validation="cfm.validation.thumbnail.show"/>
                        </image>
                        <ctaLabel
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="CTA Label"
                            listOrder="4"
                            maxlength="255"
                            metaType="text-single"
                            name="ctaLabel"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </ctaLabel>
                        <ctaLink
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="CTA Link"
                            listOrder="5"
                            maxlength="255"
                            metaType="text-single"
                            name="ctaLink"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </ctaLink>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
