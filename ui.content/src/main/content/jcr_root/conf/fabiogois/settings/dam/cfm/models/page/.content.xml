<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/fabiogois(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/fabiogois/settings/dam/cfm/models/page/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="Página do site: SEO e lista ordenada de seções/blocos."
        jcr:primaryType="cq:PageContent"
        jcr:title="Page"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <metadata jcr:primaryType="nt:unstructured"/>
        <model
            cq:targetPath="/content/entities"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="20">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="20">
                        <title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Title"
                            listOrder="1"
                            maxlength="255"
                            metaType="text-single"
                            name="title"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string"
                            required="on">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </title>
                        <slug
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Slug"
                            listOrder="2"
                            maxlength="255"
                            metaType="text-single"
                            name="slug"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string"
                            required="on"
                            unique="true">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </slug>
                        <description
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
                            cfm-element="Description"
                            checked="true"
                            default-mime-type="text/plain"
                            listOrder="3"
                            metaType="text-multi"
                            name="description"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            translatable="true"
                            valueType="string/multiline"/>
                        <blocks
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/fragmentreference/multifield"
                            allowNew="{Boolean}true"
                            fieldLabel="Blocks"
                            filter="hierarchy"
                            fragmentmodelreference="[/conf/fabiogois/settings/dam/cfm/models/section,/conf/fabiogois/settings/dam/cfm/models/hero,/conf/fabiogois/settings/dam/cfm/models/text-block]"
                            listOrder="4"
                            metaType="fragment-reference"
                            name="blocks"
                            nameSuffix="contentReference"
                            renderReadOnly="false"
                            rootPath="/content/dam/fabiogois"
                            showEmptyInReadOnly="true"
                            valueType="string/content-fragment[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
                                fragmentmodelreference="[/conf/fabiogois/settings/dam/cfm/models/section,/conf/fabiogois/settings/dam/cfm/models/hero,/conf/fabiogois/settings/dam/cfm/models/text-block]"
                                name="blocks"
                                rootPath="/content/dam/fabiogois">
                                <granite:data jcr:primaryType="nt:unstructured"/>
                            </field>
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </blocks>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
