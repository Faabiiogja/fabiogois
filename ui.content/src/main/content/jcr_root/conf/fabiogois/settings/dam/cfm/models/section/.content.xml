<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/fabiogois(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/fabiogois/settings/dam/cfm/models/section/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="Seção da página com grid de colunas."
        jcr:primaryType="cq:PageContent"
        jcr:title="Section"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <metadata jcr:primaryType="nt:unstructured"/>
        <model
            cq:targetPath="/content/entities"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="20">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="20">
                        <columns
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            emptyOption="{Boolean}false"
                            fieldLabel="Columns"
                            listOrder="1"
                            metaType="enumeration"
                            name="columns"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            unique="{Boolean}false"
                            valueType="string/enum">
                            <datasource jcr:primaryType="nt:unstructured" sling:resourceType="dam/cfm/admin/components/datasources/optionrendererenumeration" variant="default"/>
                            <optionsmultifield jcr:primaryType="nt:unstructured">
                                <item0 jcr:primaryType="nt:unstructured" fieldLabel="1 coluna" fieldValue="1"/>
                                <item1 jcr:primaryType="nt:unstructured" fieldLabel="2 colunas" fieldValue="2"/>
                                <item2 jcr:primaryType="nt:unstructured" fieldLabel="3 colunas" fieldValue="3"/>
                                <item3 jcr:primaryType="nt:unstructured" fieldLabel="4 colunas" fieldValue="4"/>
                            </optionsmultifield>
                        </columns>
                        <background
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            emptyOption="{Boolean}false"
                            fieldLabel="Background"
                            listOrder="2"
                            metaType="enumeration"
                            name="background"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            unique="{Boolean}false"
                            valueType="string/enum">
                            <datasource jcr:primaryType="nt:unstructured" sling:resourceType="dam/cfm/admin/components/datasources/optionrendererenumeration" variant="default"/>
                            <optionsmultifield jcr:primaryType="nt:unstructured">
                                <item0 jcr:primaryType="nt:unstructured" fieldLabel="Padrão" fieldValue="default"/>
                                <item1 jcr:primaryType="nt:unstructured" fieldLabel="Suave" fieldValue="muted"/>
                                <item2 jcr:primaryType="nt:unstructured" fieldLabel="Destaque" fieldValue="accent"/>
                            </optionsmultifield>
                        </background>
                        <anchorId
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Anchor ID"
                            listOrder="3"
                            maxlength="255"
                            metaType="text-single"
                            name="anchorId"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </anchorId>
                        <items
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/fragmentreference/multifield"
                            allowNew="{Boolean}true"
                            fieldLabel="Items"
                            filter="hierarchy"
                            fragmentmodelreference="[/conf/fabiogois/settings/dam/cfm/models/hero,/conf/fabiogois/settings/dam/cfm/models/text-block]"
                            listOrder="4"
                            metaType="fragment-reference"
                            name="items"
                            nameSuffix="contentReference"
                            renderReadOnly="false"
                            rootPath="/content/dam/fabiogois"
                            showEmptyInReadOnly="true"
                            valueType="string/content-fragment[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
                                fragmentmodelreference="[/conf/fabiogois/settings/dam/cfm/models/hero,/conf/fabiogois/settings/dam/cfm/models/text-block]"
                                name="items"
                                rootPath="/content/dam/fabiogois">
                                <granite:data jcr:primaryType="nt:unstructured"/>
                            </field>
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </items>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
