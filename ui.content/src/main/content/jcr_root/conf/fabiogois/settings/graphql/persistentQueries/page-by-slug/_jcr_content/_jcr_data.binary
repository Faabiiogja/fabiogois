# Retorna uma página pelo slug, com seções (grid) e blocos.
# Variáveis: {"slug": "home"}
fragment heroFields on HeroModel {
  _path
  _variation
  title
  subtitle {
    plaintext
  }
  image {
    ... on ImageRef {
      _path
      width
      height
    }
  }
  ctaLabel
  ctaLink
}

fragment textBlockFields on TextBlockModel {
  _path
  _variation
  title
  body {
    html
  }
}

query pageBySlug($slug: String!) {
  pageList(filter: {slug: {_expressions: [{value: $slug}]}}, limit: 1) {
    items {
      _path
      _variation
      title
      slug
      description {
        plaintext
      }
      blocks {
        __typename
        ...heroFields
        ...textBlockFields
        ... on SectionModel {
          _path
          _variation
          columns
          background
          anchorId
          items {
            __typename
            ...heroFields
            ...textBlockFields
          }
        }
      }
    }
  }
}
